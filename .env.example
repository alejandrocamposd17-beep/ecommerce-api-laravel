# =====================================================
#  API de E-commerce Segura - Laravel 12
#  Autor: Alejandro Campos
#  Copie este archivo a .env y complete los valores.
# =====================================================

APP_NAME="Ecommerce API"
APP_ENV=local
# Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Base de datos MySQL ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# sync envía los correos al instante; con "database" se procesan con: php artisan queue:work
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------- Proxy / HTTPS (producción) ----------
# IPs de proxies de confianza separadas por coma, o * (ej. Render) para leer la IP real del cliente
TRUSTED_PROXIES=
# true genera las URLs con https cuando la app está detrás de un proxy con TLS
FORCE_HTTPS=false

# ---------- Stripe (modo prueba) ----------
# Obtener en https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Obtener en https://dashboard.stripe.com/test/webhooks (o con `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
# Confirmar pagos desde el backend con tarjetas de prueba (siempre permitido fuera de producción)
STRIPE_ALLOW_SERVER_CONFIRM=false

# ---------- Reglas de la tienda ----------
SHOP_TAX_RATE=0.13
# Minutos antes de cancelar una orden sin pagar y liberar su stock
SHOP_PENDING_ORDER_MINUTES=30
# Órdenes sin pagar permitidas al mismo tiempo por usuario
SHOP_MAX_PENDING_ORDERS=5

# ---------- Sanctum ----------
# Minutos de vida del token (1440 = 24 horas)
SANCTUM_TOKEN_EXPIRATION=1440

# ---------- Swagger / L5-Swagger ----------
L5_SWAGGER_CONST_HOST=http://localhost:8000
# true regenera la documentación en cada request (solo desarrollo)
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
