# =====================================================
#  API de E-commerce Segura - Laravel 12
#  Autor: Alejandro Campos
#  Copie este archivo a .env y complete los valores.
# =====================================================

APP_NAME="Ecommerce API"
APP_ENV=local
# Generar con: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/El_Salvador

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Base de datos MySQL ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------- Stripe (modo prueba) ----------
# Obtener en https://dashboard.stripe.com/test/apikeys
STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Obtener en https://dashboard.stripe.com/test/webhooks (o con `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# ---------- Sanctum ----------
# Minutos de vida del token (1440 = 24 horas)
SANCTUM_TOKEN_EXPIRATION=1440

# ---------- Swagger / L5-Swagger ----------
L5_SWAGGER_CONST_HOST=http://localhost:8000
# true regenera la documentación en cada request (solo desarrollo)
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
