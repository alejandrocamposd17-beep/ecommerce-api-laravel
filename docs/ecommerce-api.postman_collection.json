              "host": [
                "{{base_url}}"
              ],
              "path": [
                "payments",
                "{{payment_id}}",
                "confirm"
              ]
            },
            "description": "Solo disponible fuera de producción. Prueba también pm_card_chargeDeclined.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payment_method\": \"pm_card_visa\"\n}"
            }
          }
        },
